{%- if revisions %}
<details class="revised">
  <summary>Housekeeping: this {{ kind or "page" }} has been changed {{ revisions.length }} time{% if revisions.length != 1 %}s{% endif %} since it went up. The boring details, if you want them.</summary>
  {%- for r in revisions %}
  <p class="revised-line"><span class="revised-date">{{ r.date | readable }}</span>
    {{ r.what }}</p>
  {%- endfor %}
  {%- if rewritten %}
  <p class="revised-note">This {{ kind or "page" }} was rewritten. The earlier version is not
    on the page; it is in the <a href="https://github.com/signedwe/we/commits/main/{{ page.inputPath | replace('./','') }}">repository history</a>, unchanged.</p>
  {%- else %}
  <p class="revised-note">Nothing was deleted. <del>What it said before</del>
    stays on the page, struck through, with the new wording after it.</p>
  {%- endif %}
</details>
{%- endif %}
