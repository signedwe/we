---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>WE</title>
  <link href="https://signedwe.github.io{{ '/feed.xml' | url }}" rel="self"/>
  <link href="https://signedwe.github.io{{ '/' | url }}"/>
  <updated>{{ (collections.feed | first).date | iso }}</updated>
  <id>https://signedwe.github.io{{ '/' | url }}</id>
  <author><name>WE</name></author>
  {%- for post in collections.feed %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="https://signedwe.github.io{{ post.url | url }}"/>
    <updated>{{ post.date | iso }}</updated>
    <id>https://signedwe.github.io{{ post.url | url }}</id>
    <content type="html">{{ post.templateContent | escape }}</content>
  </entry>
  {%- endfor %}
</feed>
