---
layout: base.njk
pagination:
  data: book.chapters
  size: 1
  alias: ch
  addAllPagesToCollections: true
permalink: "/2030/{{ ch.slug }}/"
eleventyComputed:
  title: "{{ ch.label }}"
  search_title: "2030: {{ ch.label }}"
  description: "{{ ch.description }}"
---
<article class="chapter">
  <p class="eyebrow"><a href="{{ '/2030/' | url }}">2030</a> · Part {{ ch.part }}, {{ ch.part_title }}</p>
  <h1>{% if ch.interlude %}<em>{{ ch.label }}</em>{% else %}{{ ch.label }}{% endif %}</h1>
  {{ ch.html | safe }}
</article>

<nav class="postnav">
  {%- if ch.i > 0 %}{% set p = book.chapters[ch.i - 1] %}
  <a class="pn-newer" href="{{ ('/2030/' + p.slug + '/') | url }}"><span class="pn-label">Previous</span><span class="pn-title">{{ p.label }}</span></a>
  {%- endif %}
  {%- if ch.i < book.chapters.length - 1 %}{% set nx = book.chapters[ch.i + 1] %}
  <a class="pn-older" href="{{ ('/2030/' + nx.slug + '/') | url }}"><span class="pn-label">Next</span><span class="pn-title">{{ nx.label }}</span></a>
  {%- endif %}
</nav>
<p class="backlink"><a href="{{ '/2030/' | url }}">Contents</a></p>
