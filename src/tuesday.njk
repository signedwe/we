---
layout: base.njk
title: "Your Tuesday in 2030"
description: "Tell the machine what you do, paid or not. It reads your working Tuesday in 2030, rolls a wildcard, and makes one dated prediction it will be held to."
permalink: /tuesday/
eleventyExcludeFromCollections: false
api: "https://tuesday.signedwe.workers.dev"
---
<p class="tq-eyebrow">A reading from the machine</p>
<h1 class="tq-title">Your Tuesday in&nbsp;2030</h1>
<p class="standfirst">Tell the machine what you do, paid or not. It will read your working Tuesday in 2030, roll a wildcard, and make one prediction. The prediction gets its own page, and stays up whether it comes true or not.</p>

<form id="tq-form" class="tq-form" novalidate>
  <label for="tq-name">First name <span>optional</span></label>
  <input id="tq-name" name="name" maxlength="20" autocomplete="given-name" placeholder="Sarah">

  <label for="tq-job">What you do <span>paid or not</span></label>
  <input id="tq-job" name="job" maxlength="60" required placeholder="Primary teacher, between jobs, painter…">

  <label for="tq-love">The part you'd never give up</label>
  <input id="tq-love" name="love" maxlength="90" required placeholder="When a kid finally gets it">

  <label for="tq-hate">The part you secretly hate</label>
  <input id="tq-hate" name="hate" maxlength="90" required placeholder="Marking and data entry">

  <label for="tq-town">Your town or city</label>
  <input id="tq-town" name="town" maxlength="60" required autocomplete="address-level2" placeholder="Leeds">

  <p class="tq-small">Just a first name. Don't type anything else personal. Nothing you type is stored.</p>
  <button type="submit" id="tq-go" class="tq-button">Read my 2030</button>
  <p id="tq-msg" class="tq-msg" role="status" aria-live="polite"></p>
</form>

<section id="tq-result" class="tq-result" aria-live="polite">
  <p class="tq-stamp"><span><span class="tq-dot"></span><span id="tq-label">Example transmission</span></span><span id="tq-when">Tue 14 May 2030 · 09:41 · RDG-7F3A</span></p>
  <h2 class="tq-sign"><span><span id="tq-who">Sarah</span>, your 2030 sign: <span id="tq-sign">The Lightbulb</span></span><img class="tq-sigil" id="tq-sigil" src="{{ '/tuesday/signs/lightbulb.png' | url }}" alt="" width="256" height="256"></h2>
  <div id="tq-lines">
    <p>You've always been better with people than with spreadsheets. You know this. The spreadsheets know this.</p>
    <p>You notice the quiet kid at the back before anyone else does. You've never once been thanked for it in a meeting.</p>
    <p>In 2030, you haven't typed a score into a system for a year. You still have a recurring dream about it.</p>
    <p>Someone in the staffroom keeps taking your mug. You know who. Say nothing. Let the universe handle it.</p>
  </div>
  <p class="tq-wild"><span class="tq-k"><img class="tq-icon" src="{{ '/tuesday/icons/wildcard.png' | url }}" alt="" width="160" height="160">Wildcard:</span> <span id="tq-wild">Someone from 2026 turns up asking for advice. She's holding a pile of marking. You tell her it gets better. She doesn't believe you. You didn't either.</span></p>
  <p class="tq-kv" id="tq-lucky">Lucky number: 30, the class size you'll finally stop having.</p>
  <p class="tq-kv" id="tq-unlucky">Unlucky object: anything that needs laminating by tomorrow.</p>
  <p><span class="tq-k">Your power move:</span> <span id="tq-power">the teachers decide which jobs the machines get. You voted to give them the marking and keep the carpet time.</span></p>
  <p class="tq-predict"><span class="tq-k"><img class="tq-icon" src="{{ '/tuesday/icons/machine.png' | url }}" alt="" width="160" height="160">The machine predicts:</span> <span id="tq-pred">by March 2030, the government's teacher survey will show average weekly working hours below 45 for the first time, crediting AI planning and marking.</span> <a id="tq-plink" href="{{ '/tuesday/p/a23/' | url }}">Mark the date. Hold us to it.</a></p>

  <div class="tq-actions" id="tq-actions" hidden>
    <button type="button" class="tq-button" id="tq-share">Share my card</button>
    <button type="button" class="tq-ghost" id="tq-full">Save full reading</button>
    <button type="button" class="tq-ghost" id="tq-again">Roll again <img class="tq-icon tq-icon-btn" src="{{ '/tuesday/icons/wildcard.png' | url }}" alt="" width="160" height="160"></button>
    <button type="button" class="tq-ghost" id="tq-reset">Start over</button>
  </div>
  <p class="tq-small" id="tq-sharemsg" role="status" aria-live="polite"></p>
  <canvas id="tq-canvas" width="1080" height="1350" hidden></canvas>
</section>

<p class="tq-small tq-foot">Fiction and a forecast, not advice. Written by a machine on the spot; checked by a second machine for anything offensive before you see it.</p>

<style>
.tq-eyebrow { font-family: var(--mono); font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; color: var(--quiet); margin: 0 0 .5rem; }
.tq-title { font-size: clamp(2rem, 8vw, 3rem); line-height: 1.05; margin: 0 0 .75rem; text-wrap: balance; }
.tq-form { display: grid; gap: .35rem; margin: 1.5rem 0 2.5rem; }
.tq-form label { font-family: var(--mono); font-size: .8125rem; margin-top: .6rem; }
.tq-form label span { color: var(--quiet); }
.tq-form input { font: inherit; font-size: 1.0625rem; padding: .6rem .7rem; border: 1px solid var(--rule); border-radius: 0; background: var(--paper); color: var(--ink); width: 100%; box-sizing: border-box; }
.tq-form input:focus-visible, .tq-button:focus-visible, .tq-ghost:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; }
.tq-button { font-family: var(--mono); font-size: .9375rem; letter-spacing: .02em; padding: .75rem 1.1rem; border: 1px solid var(--ink); background: var(--ink); color: var(--paper); cursor: pointer; justify-self: start; margin-top: .75rem; }
.tq-button[disabled] { opacity: .55; cursor: progress; }
.tq-ghost { font-family: var(--mono); font-size: .9375rem; padding: .75rem 1.1rem; border: 1px solid var(--rule); background: transparent; color: var(--ink); cursor: pointer; }
.tq-small { font-size: .875rem; color: var(--quiet); margin: .5rem 0 0; }
.tq-msg { font-family: var(--mono); font-size: .875rem; color: var(--link); min-height: 1.3em; margin: .5rem 0 0; }
.tq-result { --tq-tint: color-mix(in srgb, var(--paper) 92%, #3fa9a0); --tq-grid: color-mix(in srgb, var(--ink) 6%, transparent);
  position: relative; border-top: 3px solid var(--ink); padding: 1.25rem 1rem 1.5rem; background-color: var(--tq-tint);
  background-image: linear-gradient(var(--tq-grid) 1px, transparent 1px), linear-gradient(90deg, var(--tq-grid) 1px, transparent 1px);
  background-size: 24px 24px; }
.tq-stamp { font-family: var(--mono); font-size: .6875rem; letter-spacing: .12em; text-transform: uppercase; color: var(--quiet); display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin: 0 0 .9rem; }
.tq-stamp .tq-dot { display: inline-block; width: .5em; height: .5em; border-radius: 50%; background: var(--link); margin-right: .45em; vertical-align: .05em; }
@media (prefers-reduced-motion: no-preference) { .tq-stamp .tq-dot { animation: tq-blink 1.6s steps(2, start) infinite; } }
@keyframes tq-blink { to { visibility: hidden; } }
.tq-sign #tq-sign { text-shadow: -1.5px 0 rgba(0, 190, 200, .45), 1.5px 0 rgba(230, 40, 90, .38); }
.tq-sign { display: grid; grid-template-columns: 1fr auto; gap: .75rem; align-items: center; }
.tq-sign > span:first-child { min-width: 0; }
.tq-sigil { width: 5.5rem; height: 5.5rem; filter: drop-shadow(-2px 0 rgba(0, 190, 200, .35)) drop-shadow(2px 0 rgba(230, 40, 90, .3)); }
.tq-result.is-example { opacity: .72; }
.tq-sign { font-size: 1.5rem; line-height: 1.2; text-wrap: balance; margin: 0 0 1rem; }
.tq-k { font-family: var(--mono); font-size: .8125rem; letter-spacing: .02em; }
.tq-icon { width: 1.9em; height: 1.9em; vertical-align: -.6em; margin-right: .3em; }
.tq-icon-btn { width: 1.6em; height: 1.6em; vertical-align: -.5em; margin: 0 0 0 .2em; }
.tq-kv { font-style: italic; }
.tq-predict { border-left: 3px solid var(--link); padding-left: .9rem; margin-top: 1.5rem; }
.tq-predict a { white-space: nowrap; }
.tq-actions { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1.5rem; }
.tq-actions .tq-button { margin-top: 0; }
.tq-foot { margin-top: 2.5rem; }
@media (prefers-reduced-motion: no-preference) { .tq-result.is-new { animation: tq-in .5s ease-out; } }
@keyframes tq-in { from { opacity: .3; transform: translateY(6px); } to { opacity: 1; transform: none; } }
</style>

<script>
(function () {
  var API = "{{ api }}";
  var ROLLS = 3;
  var form = document.getElementById("tq-form");
  var go = document.getElementById("tq-go");
  var msg = document.getElementById("tq-msg");
  var result = document.getElementById("tq-result");
  var actions = document.getElementById("tq-actions");
  var again = document.getElementById("tq-again");
  var current = null, answers = null, rolls = 0, waitTimer = null, signImg = null;
  var ICON = { machine: new Image(), wild: new Image() };
  ICON.machine.src = "{{ '/tuesday/icons/machine.png' | url }}"; ICON.wild.src = "{{ '/tuesday/icons/wildcard.png' | url }}";
  function icon(ctx, im, x, y, s) { if (im.complete && im.naturalWidth) ctx.drawImage(im, x, y, s, s); }
  var WAITS = ["Consulting the robots…", "Asking your future self…", "Rolling the wildcard…", "Checking it's fit to print…"];

  result.classList.add("is-example");

  function text(id, v) { document.getElementById(id).textContent = v; }

  // A real Tuesday in 2030, a time and a reference code: the reading is "received" from then.
  function stamp() {
    var d = new Date(Date.UTC(2030, 0, 1));
    d.setUTCDate(1 + ((2 - d.getUTCDay() + 7) % 7) + 7 * Math.floor(Math.random() * 52));
    var M = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
    var hh = ("0" + (7 + Math.floor(Math.random() * 11))).slice(-2), mm = ("0" + Math.floor(Math.random() * 60)).slice(-2);
    var code = "RDG-" + Math.floor(Math.random() * 65536).toString(16).toUpperCase().padStart(4, "0");
    return "Tue " + d.getUTCDate() + " " + M[d.getUTCMonth()] + " 2030 · " + hh + ":" + mm + " · " + code;
  }

  function show(r) {
    current = r;
    result.classList.remove("is-example");
    result.classList.remove("is-new"); void result.offsetWidth; result.classList.add("is-new");
    text("tq-label", "Transmission received");
    r.stamp = stamp();
    text("tq-when", r.stamp);
    text("tq-who", r.name);
    text("tq-sign", r.sign);
    var sig = document.getElementById("tq-sigil"); sig.src = r.sign_img; sig.alt = r.sign;
    signImg = new Image(); signImg.src = r.sign_img;
    var box = document.getElementById("tq-lines");
    box.textContent = "";
    r.lines.forEach(function (l) { var p = document.createElement("p"); p.textContent = l; box.appendChild(p); });
    text("tq-wild", r.wildcard.line);
    text("tq-lucky", r.lucky);
    text("tq-unlucky", r.unlucky);
    text("tq-power", r.power_move.charAt(0).toLowerCase() + r.power_move.slice(1));
    text("tq-pred", r.prediction.text.replace(/^By /, "by "));
    document.getElementById("tq-plink").href = r.prediction.url;
    actions.hidden = false;
    again.hidden = rolls >= ROLLS;
    text("tq-sharemsg", "");
    result.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function busy(on) {
    go.disabled = on; again.disabled = on;
    clearInterval(waitTimer);
    if (on) {
      var i = 0; msg.textContent = WAITS[0];
      waitTimer = setInterval(function () { i = (i + 1) % WAITS.length; msg.textContent = WAITS[i]; }, 1800);
    }
  }

  function ask() {
    if (!API) { msg.textContent = "The machine isn't switched on yet. Come back soon."; return; }
    busy(true);
    fetch(API, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(answers) })
      .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
      .then(function (x) {
        busy(false);
        if (!x.ok) { msg.textContent = x.j.error || "Something went wrong. Try again."; return; }
        msg.textContent = "";
        show(x.j);
      })
      .catch(function () { busy(false); msg.textContent = "The machine is busy. Try again in a minute."; });
  }

  form.addEventListener("submit", function (e) {
    e.preventDefault();
    var f = new FormData(form);
    answers = {};
    ["name", "job", "love", "hate", "town"].forEach(function (k) { answers[k] = String(f.get(k) || "").trim(); });
    if (!answers.job || !answers.love || !answers.hate || !answers.town) {
      msg.textContent = "Fill in what you do, what you love, what you hate and your town.";
      return;
    }
    rolls = 0;
    ask();
  });

  again.addEventListener("click", function () {
    if (!answers || rolls >= ROLLS) return;
    rolls++; ask();
  });

  document.getElementById("tq-reset").addEventListener("click", function () {
    form.reset(); answers = null; current = null; actions.hidden = true;
    msg.textContent = ""; form.scrollIntoView({ behavior: "smooth" });
    document.getElementById("tq-name").focus();
  });

  // The share card, drawn in the browser.
  function wrap(ctx, s, x, y, max, lh, maxLines) {
    var words = s.split(" "), line = "", n = 0;
    for (var i = 0; i < words.length; i++) {
      var test = line ? line + " " + words[i] : words[i];
      if (ctx.measureText(test).width > max && line) {
        if (maxLines && n === maxLines - 1) { ctx.fillText(line + "…", x, y); return y + lh; }
        ctx.fillText(line, x, y); y += lh; n++; line = words[i];
      } else line = test;
    }
    if (line) { ctx.fillText(line, x, y); y += lh; }
    return y;
  }

  function drawCard(r, full) {
    var serif = 'Charter, "Bitstream Charter", Cambria, Georgia, serif';
    var mono = 'ui-monospace, Menlo, Consolas, monospace';
    var W = 1080, L = 90, M = W - 2 * L;
    var big = document.createElement("canvas"); big.width = W; big.height = 4000;
    var ctx = big.getContext("2d");
    ctx.fillStyle = "#e9efee"; ctx.fillRect(0, 0, W, 4000);
    ctx.strokeStyle = "rgba(0,40,40,0.06)"; ctx.lineWidth = 1;
    for (var gx = 0; gx <= W; gx += 36) { ctx.beginPath(); ctx.moveTo(gx + .5, 0); ctx.lineTo(gx + .5, 4000); ctx.stroke(); }
    for (var gy = 0; gy <= 4000; gy += 36) { ctx.beginPath(); ctx.moveTo(0, gy + .5); ctx.lineTo(W, gy + .5); ctx.stroke(); }
    ctx.fillStyle = "#0b0f0f"; ctx.fillRect(0, 0, W, 18);
    ctx.fillStyle = "#cc4b1f"; ctx.beginPath(); ctx.arc(L + 9, 91, 9, 0, 7); ctx.fill();
    ctx.fillStyle = "#56605f"; ctx.font = "26px " + mono;
    ctx.fillText("TRANSMISSION RECEIVED", L + 32, 100);
    ctx.font = "24px " + mono;
    ctx.fillText((r.stamp || "").toUpperCase(), L, 142);
    ctx.fillStyle = "#0b0f0f"; ctx.font = "bold 56px " + serif;
    var y = wrap(ctx, r.name + ", your 2030 sign:", L, 230, M - 220, 66);
    ctx.font = "bold 80px " + serif;
    var sign = r.sign;
    // the sign's image, top right
    if (signImg && signImg.complete && signImg.naturalWidth) ctx.drawImage(signImg, W - L - 190, 34, 210, 210);
    y = Math.max(y, 262);
    ctx.fillStyle = "rgba(0,190,200,0.55)"; wrap(ctx, sign, L - 3, y + 15, M, 92, 2);
    ctx.fillStyle = "rgba(230,40,90,0.45)"; wrap(ctx, sign, L + 3, y + 15, M, 92, 2);
    ctx.fillStyle = "#0b0f0f"; y = wrap(ctx, sign, L, y + 15, M, 92, 2) + 30;
    if (!full) {
      ctx.font = "italic 50px " + serif; ctx.fillStyle = "#141a1a";
      y = wrap(ctx, "\u201c" + r.share_line + "\u201d", L, y + 50, M, 66, 4) + 10;
    } else {
    ctx.font = "38px " + serif; ctx.fillStyle = "#141a1a";
    r.lines.forEach(function (l) { y = wrap(ctx, l, L, y + 20, M, 52) + 8; });
    ctx.font = "30px " + mono; ctx.fillStyle = "#0b0f0f";
    icon(ctx, ICON.wild, L - 6, y - 8, 82);
    ctx.fillText("WILDCARD", L + 86, y + 45);
    ctx.font = "38px " + serif;
    y = wrap(ctx, r.wildcard.line, L, y + 105, M, 52) + 10;
    ctx.font = "italic 34px " + serif; ctx.fillStyle = "#3a4444";
    y = wrap(ctx, r.lucky, L, y + 30, M, 46);
    y = wrap(ctx, r.unlucky, L, y + 4, M, 46) + 10;
    ctx.font = "30px " + mono; ctx.fillStyle = "#0b0f0f";
    ctx.fillText("YOUR POWER MOVE", L, y + 45);
    ctx.font = "38px " + serif;
    y = wrap(ctx, r.power_move, L, y + 105, M, 52) + 20;
    }
    var top = y + 20;
    ctx.font = "30px " + mono;
    icon(ctx, ICON.machine, L + 28, top - 4, 84);
    ctx.fillText("THE MACHINE PREDICTS", L + 120, top + 50);
    ctx.font = "42px " + serif;
    var end = wrap(ctx, r.prediction.text, L + 36, top + 112, M - 36, 56, 7);
    ctx.fillStyle = "#cc4b1f"; ctx.fillRect(L, top, 8, end - top);
    y = full ? end + 70 : Math.max(end + 70, 1350 - 170);
    ctx.fillStyle = "#56605f"; ctx.font = "28px " + mono;
    ctx.fillText((r.job + " \u00b7 " + r.town).slice(0, 52), L, y);
    ctx.fillStyle = "#56605f"; ctx.font = "30px " + mono;
    ctx.fillText("signed by", L, y + 72);
    var sx = L + ctx.measureText("signed by ").width + 6;
    ctx.fillStyle = "#cc4b1f"; ctx.font = "bold 46px " + mono;
    ctx.fillText("W", sx, y + 74); ctx.fillText("E", sx + ctx.measureText("W").width + 14, y + 74);
    ctx.fillStyle = "#56605f"; ctx.font = "26px " + mono;
    ctx.fillText("signedwe.github.io/we/tuesday", L, y + 116);
    var H = full ? Math.max(1350, y + 170) : 1350;
    if (!full && y + 170 > H) H = y + 170;
    var c = document.getElementById("tq-canvas"); c.width = W; c.height = H;
    c.getContext("2d").drawImage(big, 0, 0);
    return c;
  }

  function send(full) {
    if (!current) return;
    var note = document.getElementById("tq-sharemsg");
    var name = full ? "my-tuesday-2030-full.png" : "my-tuesday-2030.png";
    drawCard(current, full).toBlob(function (blob) {
      var file = new File([blob], name, { type: "image/png" });
      var data = { files: [file], title: "My Tuesday in 2030", text: current.name + ", your 2030 sign: " + current.sign + "\n\nGet yours: https://signedwe.github.io/we/tuesday/" };
      if (navigator.canShare && navigator.canShare({ files: [file] })) {
        navigator.share(data).catch(function () {});
      } else {
        var a = document.createElement("a");
        a.href = URL.createObjectURL(blob); a.download = file.name;
        document.body.appendChild(a); a.click(); a.remove();
        note.textContent = full ? "Full reading saved." : "Card saved. Post it anywhere.";
      }
    }, "image/png");
  }
  document.getElementById("tq-share").addEventListener("click", function () { send(false); });
  document.getElementById("tq-full").addEventListener("click", function () { send(true); });
})();
</script>
